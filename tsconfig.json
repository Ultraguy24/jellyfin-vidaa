{
  "compilerOptions": {
    "target": "ES2015",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2015", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "vite.config.ts"]
}
